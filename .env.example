# 复制为 .env 后按需修改：  cp .env.example .env
# 改 QA_ENV 切换测试/生产，然后重启服务。

# ★ 环境切换：test | prod
QA_ENV=test

QA_API_HOST=127.0.0.1
QA_API_PORT=8765
# 生产同机部署推荐: QA_API_HOST=127.0.0.1  QA_API_PORT=18765  QA_NGINX_PORT=18780
# 禁止占用 80/443/1433/3306/8787/8080 等（见 deploy/ports.py）
QA_NGINX_PORT=18780

# ★ 访问令牌：非空时 /api/* 与 /download/* 必须携带。
#   监听非回环地址（如 0.0.0.0）而未设置令牌时，服务会拒绝启动。
#   浏览器请走 /login.html（ERP/MES 账号）；自动化用请求头：
#   Authorization: Bearer <本值>  或  X-API-Token: <本值>
#   URL ?token= 已禁用（防进访问日志/历史）。
#   生成方式：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
QA_API_TOKEN=

# CORS：默认留空=仅同源（不发送跨域头）；独立前端再填 https://your.ui 或 *
QA_CORS_ORIGIN=
# 500 是否把异常原文回传前端（默认 0；排查时临时设 1）
QA_DEBUG_ERRORS=0
# 导出目录（output/）保留天数：超过则清理 .pdf/.xlsx/.csv；0=不清理
QA_OUTPUT_RETENTION_DAYS=30
# 生产指向桥接库时须设 1；正式独立库后改 0
QA_PROD_ALLOW_BRIDGE=0

# 默认桥接库（测试常用）
QA_ZR_DB=/path/to/pythonProject_zr_aicoding/backend/erp.db

# 测试环境（可选覆盖）
# QA_TEST_ERP_DB=
# QA_TEST_MES_DB=
# QA_TEST_KB=
# QA_TEST_GRAPHRAG_URL=
# 测试 8D（默认本机开发口）
QA_TEST_8D_API_BASE=http://127.0.0.1:8001
# QA_TEST_8D_API_KEY=

# 生产环境（QA_ENV=prod 时使用；请显式填写）
QA_PROD_ERP_DB=/path/to/prod_or_bridge/erp.db
QA_PROD_MES_DB=/path/to/prod_or_bridge/erp.db
# QA_PROD_KB=
# QA_PROD_GRAPHRAG_URL=
# 生产 8D 公网入口（Nginx :18880；勿填本机 8001）
QA_PROD_8D_API_BASE=http://175.178.238.31:18880
# QA_PROD_8D_API_KEY=

QA_GRAPHRAG_URL=http://175.178.238.31
# 只读知识图谱查询缓存秒数（调大可减少重复查询耗时）
QA_GRAPHRAG_CACHE_TTL=1800
QA_8D_API_TIMEOUT=180

# ERP/MES 登录（zr_aicoding POST /api/auth/login）
QA_REQUIRE_LOGIN=1
QA_TEST_ERP_AUTH_BASE=http://127.0.0.1:8009
QA_PROD_ERP_AUTH_BASE=http://127.0.0.1:8009
QA_LOGIN_ENTERPRISES=江西中软电子有限公司
# 登录会话有效期（秒）：默认 12 小时，按班次重新登录
QA_SESSION_TTL_SECONDS=43200
# Cookie Secure：1=强制；0=关闭；auto=检测到 HTTPS / X-Forwarded-Proto=https 时开启
QA_COOKIE_SECURE=auto

# 反向代理信任：auto=仅当直连对端是本机回环时信任 X-Real-IP / X-Forwarded-For；
# 1=始终信任（仅限前面确有你自己的反代）；0=一律用 TCP 对端地址
QA_TRUST_PROXY=auto
# 请求体上限（字节，默认 2MB）；超限返回 413
QA_MAX_BODY_BYTES=2097152
# 管理操作角色白名单（逗号分隔，如 admin,quality_manager）。
# 留空=不限制；配置后 8D删除/无效稿清理/历史清理/桥接同步 仅这些角色或服务令牌可执行
QA_ADMIN_ROLES=

# 生产桥接表后台同步：默认关闭；显式设 1 才在 QA_ENV=prod 时周期刷新桥接表
# QA_BRIDGE_SYNC=1
# QA_BRIDGE_SYNC_SEC=600

# 生产部署详见 deploy/DEPLOY.md
