# ═══════════════════════════════════════════════════
# PCB 品质分析系统 — 生产环境变量模板
# 用法：复制到项目根目录 .env 后按实机修改
#   cp deploy/env.production.example .env
#
# ★ 同机部署（与 MES/ERP 共用服务器）端口约定：
#   - API 仅本机: 127.0.0.1:18765（禁止 80/443/1433/3306/8787/8080…）
#   - Nginx 对外: 18780（禁止抢 80/443）
#   - 改端口前先: ss -lntup | grep -E ':18765|:18780'
# ═══════════════════════════════════════════════════

QA_ENV=prod

# ─── 服务（仅本机，不直接对外）───
QA_API_HOST=127.0.0.1
QA_API_PORT=18765
QA_CORS_ORIGIN=
# Nginx 对外端口（仅文档/预检用，真正 listen 写在 nginx 配置里）
QA_NGINX_PORT=18780

# 生产启动：若仍指向桥接库，必须显式允许（正式独立库上线后改为 0）
QA_PROD_ALLOW_BRIDGE=1

# ─── 生产 ERP / MES（必填）───
QA_PROD_ERP_DB=/data/pcb-quality/erp.db
QA_PROD_MES_DB=/data/pcb-quality/erp.db
# QA_PROD_KB=/opt/pcb-quality/data/quality_knowledge_prod.db

# GraphRAG（生产机须能访问）
QA_PROD_GRAPHRAG_URL=http://175.178.238.31
QA_GRAPHRAG_URL=http://175.178.238.31
QA_GRAPHRAG_TIMEOUT=12
QA_GRAPHRAG_CACHE_TTL=1800

# 8D 智能生成公网入口（与 pythonProject_8D_report Nginx :18880 一致）
# ★ 生产只用 QA_PROD_8D_API_BASE，切勿写成 127.0.0.1:8001
QA_PROD_8D_API_BASE=http://175.178.238.31:18880
# QA_PROD_8D_API_KEY=
QA_8D_API_TIMEOUT=180

# ERP/MES 登录（同机回环；远端 MES 再改 QA_PROD_ERP_AUTH_BASE）
QA_REQUIRE_LOGIN=1
QA_PROD_ERP_AUTH_BASE=http://127.0.0.1:8009
QA_LOGIN_ENTERPRISES=江西中软电子有限公司
# 登录会话有效期（秒）：默认 12 小时，按班次重新登录
QA_SESSION_TTL_SECONDS=43200
# 生产若经 HTTPS / 反代，建议 QA_COOKIE_SECURE=1（或保持 auto）
QA_COOKIE_SECURE=auto
# 反代头信任：auto=仅信任本机回环对端转发的 X-Real-IP / X-Forwarded-For
QA_TRUST_PROXY=auto
QA_MAX_BODY_BYTES=2097152
# 导出目录（output/）保留天数：超过则清理 .pdf/.xlsx/.csv；0=不清理
QA_OUTPUT_RETENTION_DAYS=30
# 管理操作（8D删除/清理/桥接同步）角色白名单；留空不限制
QA_ADMIN_ROLES=

# 桥接表后台同步默认关闭；确需周期刷新桥接库时显式开启
# QA_BRIDGE_SYNC=1
# QA_BRIDGE_SYNC_SEC=600

# ─── 品质目标（可按工厂调整）───
QA_TARGET_SCRAP_RATE=2.0
QA_WARN_SCRAP_RATE=5.0
QA_CRIT_SCRAP_RATE=10.0
QA_TARGET_PASS_RATE=98.0
QA_TARGET_PROCESS_YIELD=95.0
