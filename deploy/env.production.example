# ═══════════════════════════════════════════════════
# PCB 品质分析系统 — 生产环境变量模板
# 用法：复制到项目根目录 .env 后按实机修改
#   cp deploy/env.production.example .env
#
# ★ 同机部署（与 MES/ERP 共用服务器）端口约定：
#   - API 仅本机: 127.0.0.1:18765（禁止 80/443/1433/3306/8787/8080…）
#   - Nginx 对外: 18780（禁止抢 80/443）
#   - 改端口前先: ss -lntup | grep -E ':18765|:18780'
# ═══════════════════════════════════════════════════

QA_ENV=prod

# ─── 服务（仅本机，不直接对外）───
QA_API_HOST=127.0.0.1
QA_API_PORT=18765
QA_CORS_ORIGIN=
# Nginx 对外端口（仅文档/预检用，真正 listen 写在 nginx 配置里）
QA_NGINX_PORT=18780

# 生产启动：若仍指向桥接库，必须显式允许（正式独立库上线后改为 0）
QA_PROD_ALLOW_BRIDGE=1

# ─── 生产 ERP / MES（必填）───
QA_PROD_ERP_DB=/data/pcb-quality/erp.db
QA_PROD_MES_DB=/data/pcb-quality/erp.db
# QA_PROD_KB=/opt/pcb-quality/data/quality_knowledge_prod.db

# GraphRAG（生产机须能访问）
QA_PROD_GRAPHRAG_URL=http://175.178.238.31
QA_GRAPHRAG_URL=http://175.178.238.31
QA_GRAPHRAG_TIMEOUT=12

# ─── 品质目标（可按工厂调整）───
QA_TARGET_SCRAP_RATE=2.0
QA_WARN_SCRAP_RATE=5.0
QA_CRIT_SCRAP_RATE=10.0
QA_TARGET_PASS_RATE=98.0
QA_TARGET_PROCESS_YIELD=95.0
